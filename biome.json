{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!public",
			"!.agents",
			"!.claude",
			"!skills.json",
			"!skills.lock.json",
			"!skills-lock.json",
			"!worker-configuration.d.ts",
			"!src/components/animate-ui",
			"!src/components/ui",
			"!pnpm-lock.yaml"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.md"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["src/lib/get-strict-context.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
