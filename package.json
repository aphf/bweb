{
	"name": "bweb",
	"private": true,
	"version": "2.0.0",
	"packageManager": "pnpm@12.4.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"preview": "vite preview",
		"dev:worker": "wrangler dev",
		"deploy": "wrangler deploy",
		"deploy:dry": "wrangler deploy --dry-run",
		"cf-typegen": "wrangler types --env-interface Env",
		"check:worker": "tsc -b worker/tsconfig.json",
		"test": "vitest run",
		"email": "email dev --dir emails --port 3000",
		"prepare": "husky"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-context-menu": "^2.4.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"drawably": "^0.4.2",
		"highlight.js": "^11.12.0",
		"jose": "^6.2.15",
		"katex": "^0.19.1",
		"lucide-react": "^1.68.0",
		"motion": "^14.9.1",
		"nucleo-isometric": "^1.1.1",
		"nucleo-micro-bold-essential": "^1.0.5",
		"nucleo-ui-essential-fill-18": "^1.1.7",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-email": "^6.11.6",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-rnd": "^10.5.3",
		"react-router": "^8.5.1",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"resend": "^6.37.0",
		"rough-notation": "^0.5.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@cloudflare/vitest-plugin": "^1.5.1",
		"@cloudflare/workers-types": "^5.20261104.1",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@react-email/ui": "6.11.6",
		"@tailwindcss/postcss": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"autoprefixer": "^10.6.2",
		"husky": "^9.1.7",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"wrangler": "^4.135.0"
	}
}
