{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
		"strict": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"noEmit": true,
		"tsBuildInfoFile": "../node_modules/.tmp/tsconfig.workers.tsbuildinfo",
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true
	},
	"include": [
		"./**/*.ts",
		"../emails/**/*.ts",
		"../emails/**/*.tsx",
		"../worker-configuration.d.ts"
	]
}
