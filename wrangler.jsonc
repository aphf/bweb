{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "neosphere",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/stats.js",
			"/via/*",
			"/x",
			"/twitter",
			"/gh",
			"/github",
			"/li",
			"/linkedin",
			"/tg",
			"/telegram",
			"/ig",
			"/instagram",
			"/about",
			"/about/*",
			"/contact",
			"/contact/*",
			"/projects",
			"/projects/*",
			"/notes",
			"/notes/*",
			"/404",
			"/gallery",
			"/gallery/*",
			"/media/*",
			"/assets/*",
			"/shared/*"
		]
	},
	"vars": {
		"SPOTIFY_API_URL": "https://s.bahauddin.in/v1/me/player/currently-playing",
		"X_API_URL": "https://x-profile-api.himanshu-ranjan.workers.dev"
	},
	"r2_buckets": [
		{
			"binding": "neosphere_assets",
			"bucket_name": "neosphere-assets"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "neosphere-db",
			"database_id": "4ec14f0d-7ce9-4ae7-8469-3074b38fe915"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMITER",
			"id": "19cedcf4b7c3426d806e9a282a20a0a0",
			"preview_id": "19cedcf4b7c3426d806e9a282a20a0a0"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "LIVE_COUNTER", "class_name": "LiveCounter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveCounter"] }],
	"triggers": {
		"crons": ["* * * * *", "30 6 * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
